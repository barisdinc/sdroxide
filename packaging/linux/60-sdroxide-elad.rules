# ELAD FDM-DUO, FDM-S2 and FDM-S1, for sdroxide's native USB driver.
#
# sdroxide talks to these directly with nusb rather than through libusb or
# ELAD's own gr-elad, but the kernel-level requirement is the same: the invoking
# user needs write access to the usbfs node.
#
# These ids are the *receive* interface only — the one carrying the DDC's I/Q.
# An FDM-DUO is three USB devices, and the other two need nothing installed:
# its CAT port is an FTDI bridge (0403:6001, handled by the in-tree ftdi_sio
# driver, appearing as /dev/ttyUSB*) and its audio port is a USB audio class
# device (0d8c:01af). If CAT is refused rather than the receiver, the problem is
# the dialout group, not this file.
#
# TAG+="uaccess" hands an ACL to whoever is logged in at the active seat, which
# needs no group to exist and no re-login. It is the better half of this rule
# and it is not the whole of it: uaccess grants nothing where there is no seat
# to be logged in at — WSL2, a headless box reached over ssh, a container, or
# sdroxide running as a systemd service — and the device stays root-owned and
# unreachable for reasons nothing on screen explains (issue #350).
#
# So GROUP="plugdev" comes along as a fallback, taking effect for anyone in
# that group when the ACL does not. Where the group does not exist, udev logs
# one line and applies the rest of the rule, so nothing is lost by asking. To
# use it:
#
#   sudo groupadd -f plugdev && sudo usermod -aG plugdev $USER
#
# then log out and back in (`newgrp plugdev` for the current shell).
#
# Install:
#   sudo cp 60-sdroxide-elad.rules /usr/lib/udev/rules.d/
#   sudo udevadm control --reload
# then unplug and replug the device.

# FDM-DUO / FDM-DUOr transceiver.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1721", ATTRS{idProduct}=="061a", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# FDM-S2 sampler.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1721", ATTRS{idProduct}=="061c", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# FDM-S1 sampler.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1721", ATTRS{idProduct}=="0610", MODE="0660", GROUP="plugdev", TAG+="uaccess"
